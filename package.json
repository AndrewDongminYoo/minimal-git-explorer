{
  "name": "minimal-git-explorer",
  "displayName": "Minimal Git Explorer",
  "description": "A lightweight local-first Git explorer for commits, branches, remotes, stashes, tags, and worktrees in the VS Code Source Control sidebar.",
  "version": "0.2.0",
  "packageManager": "pnpm@11.21.0",
  "publisher": "dongminyu",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dongminyu/minimal-git-explorer"
  },
  "homepage": "https://github.com/dongminyu/minimal-git-explorer#readme",
  "bugs": {
    "url": "https://github.com/dongminyu/minimal-git-explorer/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "source-control",
    "commits",
    "branches",
    "stashes",
    "worktrees",
    "tags"
  ],
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Local Git commands and Git hooks run only after the workspace is trusted."
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "scm": [
        {
          "id": "minimal-git-explorer.commits",
          "name": "Commits",
          "icon": "resources/views/commits.svg"
        },
        {
          "id": "minimal-git-explorer.branches",
          "name": "Branches",
          "icon": "resources/views/branches.svg"
        },
        {
          "id": "minimal-git-explorer.remotes",
          "name": "Remotes",
          "icon": "resources/views/remotes.svg"
        },
        {
          "id": "minimal-git-explorer.stashes",
          "name": "Stashes",
          "icon": "resources/views/stashes.svg"
        },
        {
          "id": "minimal-git-explorer.tags",
          "name": "Tags",
          "icon": "resources/views/tags.svg"
        },
        {
          "id": "minimal-git-explorer.worktrees",
          "name": "Worktrees",
          "icon": "resources/views/worktrees.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "minimal-git-explorer.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Git Explorer"
      },
      {
        "command": "minimal-git-explorer.openCommit",
        "title": "Open Commit",
        "category": "Git Explorer"
      },
      {
        "command": "minimal-git-explorer.checkoutBranch",
        "title": "Checkout Branch",
        "category": "Git Explorer"
      },
      {
        "command": "minimal-git-explorer.copyRemoteUrl",
        "title": "Copy Remote URL",
        "category": "Git Explorer"
      },
      {
        "command": "minimal-git-explorer.showStash",
        "title": "Show Stash",
        "category": "Git Explorer"
      },
      {
        "command": "minimal-git-explorer.applyStash",
        "title": "Apply Stash",
        "category": "Git Explorer"
      },
      {
        "command": "minimal-git-explorer.copyTagName",
        "title": "Copy Tag Name",
        "category": "Git Explorer"
      },
      {
        "command": "minimal-git-explorer.openWorktree",
        "title": "Open Worktree in New Window",
        "category": "Git Explorer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "minimal-git-explorer.refresh",
          "when": "view =~ /^minimal-git-explorer\\./",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "minimal-git-explorer.openCommit",
          "when": "view == minimal-git-explorer.commits && viewItem == commit",
          "group": "1_commit"
        },
        {
          "command": "minimal-git-explorer.checkoutBranch",
          "when": "view == minimal-git-explorer.branches && viewItem == localBranch",
          "group": "1_branch"
        },
        {
          "command": "minimal-git-explorer.copyRemoteUrl",
          "when": "view == minimal-git-explorer.remotes && viewItem == remoteUrl",
          "group": "1_remote"
        },
        {
          "command": "minimal-git-explorer.showStash",
          "when": "view == minimal-git-explorer.stashes && viewItem == stash",
          "group": "1_stash@1"
        },
        {
          "command": "minimal-git-explorer.applyStash",
          "when": "view == minimal-git-explorer.stashes && viewItem == stash",
          "group": "1_stash@2"
        },
        {
          "command": "minimal-git-explorer.copyTagName",
          "when": "view == minimal-git-explorer.tags && viewItem == tag",
          "group": "1_tag"
        },
        {
          "command": "minimal-git-explorer.openWorktree",
          "when": "view == minimal-git-explorer.worktrees && viewItem == worktree",
          "group": "1_worktree"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~26.2.0",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
